{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "outputDirectory": "dist/ng-movie-database/browser",
  "functions": {
    "api/ssr.mjs": {
      "includeFiles": "dist/ng-movie-database/**"
    }
  },
  "headers": [
    {
      "source": "/:file((?:main|chunk|polyfills|styles)-[A-Za-z0-9_-]{8}\\.(?:js|css))",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/api/ssr"
    }
  ]
}
